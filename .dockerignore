# The build context is only what is needed to stage www/ and build the APK.

.git
.github

# Generated by the build itself; regenerating them inside the image is the whole
# point, and copying them in would let stale local state leak into the APK.
node_modules
android
www
dist

# Never let signing material near the build context. It reaches the build only
# through --mount=type=secret.
secrets

# Not part of the Android app. downloads/ is 9.2 MB of archives that the staging
# step deliberately excludes, and game/ is the Python desktop edition.
downloads
game

docs
tests
*.md
!README.md
